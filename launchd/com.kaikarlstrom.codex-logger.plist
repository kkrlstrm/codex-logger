<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kaikarlstrom.codex-logger</string>

    <!-- Ingest changed Codex rollout files every 5 minutes. Cheap: unchanged
         files are skipped by size+mtime, so this is near-zero work when idle. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>codex_logger</string>
        <string>ingest</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kaikarlstrom/kai-gtm-agents/codex-logger</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- default is ~/.codex-logger/codex.db; set a postgresql:// URL here to
             co-locate with cc-logger's Neon warehouse. -->
        <key>CODEX_LOGGER_DB</key>
        <string></string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/kaikarlstrom/Library/Logs/codex-logger.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kaikarlstrom/Library/Logs/codex-logger.err.log</string>
</dict>
</plist>
